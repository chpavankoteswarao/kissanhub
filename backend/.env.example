# =================================================================
# KISSAN-HUB ENVIRONMENT CONFIGURATION
# Official Government of India Open Government Data (data.gov.in) API
# =================================================================

# Server Listening Port
PORT=5000

# Official Government of India OGD API Key
# Sign up and obtain your free API key at: https://data.gov.in/
# Paste your secret API key below:
GOV_API_KEY=YOUR_DATA_GOV_IN_API_KEY_HERE

# Official Mandi / Market-Price Resource ID from data.gov.in
# Standard Daily Mandi Prices Resource: 9ef84268-d588-465a-a308-a864a43d0070
MANDI_PRICE_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Cache duration in minutes (to respect government API limits and prevent latency)
MANDI_CACHE_MINUTES=30

# Google Gemini API Configuration
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite

# WebRTC STUN/TURN Configuration (For Voice & Video Calling)
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=
